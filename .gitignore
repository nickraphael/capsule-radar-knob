# Editors / OS
.vscode/
.idea/
.DS_Store

# Build artifacts
*.bin
*.elf
*.map
build/
dist/

# Secrets (WiFi creds live in NVS on the device, never in the repo)
secrets.h

# Generated by the LCD-2.1 build (custom_sdkconfig = ESP-IDF component mode)
/.dummy/
/CMakeLists.txt
/dependencies.lock
/managed_components/
/sdkconfig.defaults
/sdkconfig.esp32-s3-lcd-21

# Python venv for esptool (Docker build workflow, see README)
.venv/

# The bring-up firmware's own copy of Waveshare's panel init values (made by bringup/gen_init.py) stays out of
# the repo. The radar firmware's copy, src/boards/st77916_knob_init.h, IS committed: see the licence note in
# its header (Waveshare's demo has no license file, so those values remain Waveshare's).
bringup/st77916_knob_init.h

# Local project notes: they hold local paths and device identifiers, so they stay out of the repo
context.txt


# Python bytecode: running tools/gen_*.py leaves a __pycache__ behind (one was committed by mistake)
__pycache__/
*.pyc
